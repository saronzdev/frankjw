    "dotenv": "^17.0.0",
    "lucide-preact": "^1.59.0",
    "preact": "^10.26.9",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.1",
    "@testing-library/preact": "^3.2.4",
